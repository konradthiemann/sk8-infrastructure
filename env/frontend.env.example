# Vorlage für sk8-skate, sk8-nutrition und sk8-habits. Vite liest die Werte zur Build-Zeit ein (VITE_-Präfix).

# Basis-URL des Backends ohne Pfad und ohne abschließenden Slash; die Apps hängen /api/... selbst an.
VITE_API_URL=http://localhost:8000

# API-Key für den Header X-Api-Key – muss APP_API_KEY des Backends entsprechen; landet bewusst im Bundle (ADR-006).
VITE_API_KEY=dev-key-change-me

# UX-Telemetrie an das Backend senden (true/false); lokal auf false setzen, wenn keine Testdaten anfallen sollen.
VITE_TELEMETRY=on

# Port, auf dem Caddy lauscht; lokal Standard 80, in Railway von der Plattform überschrieben,
# trotzdem explizit gesetzt, damit Railways Port-Erkennung am Image nichts erraten muss.
PORT=80
