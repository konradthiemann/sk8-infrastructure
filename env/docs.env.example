# Vorlage für sk8-docs. Lokal als .env.local ins Docs-Repo kopieren, in Railway als Service-Variablen setzen.

# Symfony-Umgebung: dev (lokal), test (PHPUnit), prod (Railway – auch im Development-Environment).
APP_ENV=dev

# Symfony-Geheimnis für signierte URLs, CSRF u. Ä. – 32 Hex-Zeichen, z. B. `openssl rand -hex 16`.
APP_SECRET=

# Doctrine-DSN auf die Datenbank sk8_docs; lokal Compose-Postgres (Port ggf. gemäß POSTGRES_PORT anpassen), in Railway per Referenzvariablen.
DATABASE_URL="postgresql://sk8:sk8@127.0.0.1:5432/sk8_docs?serverVersion=16&charset=utf8"
