# Vorlage für sk8-backend. Lokal als .env.local ins Backend-Repo kopieren, in Railway als Service-Variablen setzen.

# Symfony-Umgebung: dev (lokal), test (PHPUnit), prod (Railway – auch im Development-Environment).
APP_ENV=dev

# Symfony-Geheimnis für signierte URLs, CSRF u. Ä. – 32 Hex-Zeichen, z. B. `openssl rand -hex 16`.
APP_SECRET=

# Doctrine-DSN; lokal auf den Compose-Postgres (Port ggf. gemäß POSTGRES_PORT anpassen), in Railway per Referenzvariablen auf den Service postgres (siehe railway/README.md).
DATABASE_URL="postgresql://sk8:sk8@127.0.0.1:5432/sk8_backend?serverVersion=16&charset=utf8"

# Statischer API-Key, den alle Clients im Header X-Api-Key mitschicken; pro Environment ein eigener Wert (ADR-006).
APP_API_KEY=dev-key-change-me

# Zeitzone, gegen die "jetzt" bei Zukunfts-Validierungen verglichen wird (T-0102, z. B. sessionDate/startedAt).
APP_TIMEZONE=Europe/Berlin

# CORS-Allowlist als Regex über die erlaubten Frontend-Origins (NelmioCorsBundle); lokal die drei Vite-Ports.
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1):517[3-5]$'

# Anthropic-API-Key – lokal leer lassen, dann antworten KI-Endpunkte mit 503 und alles andere funktioniert (ADR-010).
ANTHROPIC_API_KEY=

# Modell für Bildanalyse (Etiketten-Scan): kleinstes ausreichendes Modell (ADR-010).
AI_MODEL_VISION=claude-haiku-4-5

# Modell für Textaufgaben (Muster, Prognosen, Vorschläge): kleinstes ausreichendes Modell (ADR-010).
AI_MODEL_TEXT=claude-haiku-4-5

# Symfony-Messenger-Transport für asynchrone KI-Batch-Jobs; Tabelle messenger_messages kommt per Migration (ADR-002).
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# Basis-URL für absolute URLs außerhalb eines HTTP-Requests (CLI, Messenger); in Railway https://<backend-domain>.
DEFAULT_URI=http://localhost:8000

# Port, auf dem FrankenPHP lauscht (Caddy-SERVER_NAME); lokal 8000, in Railway von der Plattform
# überschrieben, deshalb dort trotzdem explizit gesetzt (fester Healthcheck-Pfad, kein Erraten).
PORT=8000

# Vertrauenswürdige Proxys für Symfony; REMOTE_ADDR akzeptiert den unmittelbar vorgeschalteten Proxy
# als vertrauenswürdig (Railway terminiert TLS selbst, X-Forwarded-Proto muss ankommen).
SYMFONY_TRUSTED_PROXIES=REMOTE_ADDR
